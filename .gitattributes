# Normalize text files in the repository
* text=auto

# Source and docs
*.cs    text diff=csharp
*.py    text eol=lf
*.md    text
*.txt   text

# Windows scripts keep CRLF
*.ps1   text eol=crlf

# Unix scripts must keep LF
*.sh    text eol=lf

# Binary assets
*.png   binary
*.dll   binary
*.zip   binary
